# Auto detect text files and perform LF normalization
* text=auto

# Windows command scripts are CRLF in a working copy whatever the checkout's autocrlf (cmd.exe
# mishandles labels and goto in LF files); shell scripts are LF everywhere (sh fails on CRLF)
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf

# Bash's recorded output is compared byte for byte with fsh's, which writes LF: these files
# are LF in a working copy whatever the checkout's autocrlf
src/test/resources/bash-compat/** text eol=lf
