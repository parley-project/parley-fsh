posix=0
emacs          	off
hashall        	on
ignoreeof      	off
keyword        	off
monitor        	off
nolog          	off
posix          	off
privileged     	off
vi             	off
flags=hB
flags=B
c=7 d=8 args=a b
c= d= args=a c=7
