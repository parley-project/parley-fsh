<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- fsh, the FileSource Shell. Built on Parley (parley-files) but not part of it. -->
	<groupId>us.bringardner</groupId>
	<artifactId>fsh</artifactId>
	<version>2.0.0-SNAPSHOT</version>
	<name>fsh - the FileSource Shell</name>
	<description>A bash-like shell whose file system is any parley-files FileSource: the local disk,
		memory, FTP, SFTP or a database. Formerly us.bringardner:bjl_shell (BjlShell).</description>
	<url>https://github.com/tony-bringardner/fsh</url>
	<inceptionYear>2004</inceptionYear>

	<licenses>
		<license>
			<name>The Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<developers>
		<developer>
			<id>tony-bringardner</id>
			<name>Tony Bringardner</name>
			<url>https://github.com/tony-bringardner</url>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:https://github.com/tony-bringardner/fsh.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/tony-bringardner/fsh.git</developerConnection>
		<url>https://github.com/tony-bringardner/fsh/tree/master</url>
	</scm>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>11</maven.compiler.release>
		<parley.version>2.0.0-SNAPSHOT</parley.version>
		<!-- set by the native-PLATFORM profile for this machine, when its native files are built -->
		<fsh.platform>none</fsh.platform>
		<fsh.native.dir>none</fsh.native.dir>
	</properties>

	<profiles>
		<!-- fsh-VERSION-linux-x86_64.jar: this platform's keyboard library and fshexec (linux/compile.sh), which
		     parley-launcher unpacks for fsh; made only where they have been built -->
		<profile>
			<id>native-linux-x86_64</id>
			<activation>
				<os>
					<family>unix</family>
					<name>linux</name>
					<arch>amd64</arch>
				</os>
				<file>
					<exists>${basedir}/linux/fshexec</exists>
				</file>
			</activation>
			<properties>
				<fsh.platform>linux-x86_64</fsh.platform>
				<fsh.native.dir>linux</fsh.native.dir>
			</properties>
		</profile>
		<!-- fsh-VERSION-linux-aarch64.jar: this platform's keyboard library and fshexec (linux/compile.sh), which
		     parley-launcher unpacks for fsh; made only where they have been built -->
		<profile>
			<id>native-linux-aarch64</id>
			<activation>
				<os>
					<family>unix</family>
					<name>linux</name>
					<arch>aarch64</arch>
				</os>
				<file>
					<exists>${basedir}/linux/fshexec</exists>
				</file>
			</activation>
			<properties>
				<fsh.platform>linux-aarch64</fsh.platform>
				<fsh.native.dir>linux</fsh.native.dir>
			</properties>
		</profile>
		<!-- fsh-VERSION-macos-x86_64.jar: this platform's keyboard library and fshexec (macos/compile.sh), which
		     parley-launcher unpacks for fsh; made only where they have been built -->
		<profile>
			<id>native-macos-x86_64</id>
			<activation>
				<os>
					<family>mac</family>
					<name>mac os x</name>
					<arch>x86_64</arch>
				</os>
				<file>
					<exists>${basedir}/macos/fshexec</exists>
				</file>
			</activation>
			<properties>
				<fsh.platform>macos-x86_64</fsh.platform>
				<fsh.native.dir>macos</fsh.native.dir>
			</properties>
		</profile>
		<!-- fsh-VERSION-macos-aarch64.jar: this platform's keyboard library and fshexec (macos/compile.sh), which
		     parley-launcher unpacks for fsh; made only where they have been built -->
		<profile>
			<id>native-macos-aarch64</id>
			<activation>
				<os>
					<family>mac</family>
					<name>mac os x</name>
					<arch>aarch64</arch>
				</os>
				<file>
					<exists>${basedir}/macos/fshexec</exists>
				</file>
			</activation>
			<properties>
				<fsh.platform>macos-aarch64</fsh.platform>
				<fsh.native.dir>macos</fsh.native.dir>
			</properties>
		</profile>
		<!-- Native binary named fsh: mvn -Pnative package (add jdbc to include the JDBC file system) -->
		<profile>
			<id>native</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.graalvm.buildtools</groupId>
						<artifactId>native-maven-plugin</artifactId>
						<version>0.11.0</version>
						<extensions>true</extensions>
						<executions>
							<execution>
								<id>build-native</id>
								<goals>
									<goal>compile-no-fork</goal>
								</goals>
								<phase>package</phase>
							</execution>
						</executions>
						<configuration>
							<imageName>fsh</imageName>
							<mainClass>us.bringardner.fsh.Console</mainClass>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!-- The OS keychain for credential references (@keychain:parley/ftp): macOS Keychain, Linux
		     Secret Service, Windows Credential Manager. Not used by fsh's code: parley-files finds it
		     through ServiceLoader. In every build except the native image's (-Dparley.fsh.noKeychain, which
		     the build-native scripts pass): it works through JNA, which the native image isn't set up
		     for, so there @keychain: is simply not available. Needs Java 17 at run time; on an older
		     JVM the keychain store is left out. -->
		<profile>
			<id>keychain</id>
			<activation>
				<property>
					<name>!parley.fsh.noKeychain</name>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>us.bringardner.parley</groupId>
					<artifactId>parley-credentials-keychain</artifactId>
					<version>2.0.0-SNAPSHOT</version>
					<scope>runtime</scope>
				</dependency>
				<!-- java-keyring brings jna-platform 5.13; JNA's two jars must be the same version as
				     the jna fsh uses -->
				<dependency>
					<groupId>net.java.dev.jna</groupId>
					<artifactId>jna-platform</artifactId>
					<version>5.19.1</version>
					<scope>runtime</scope>
				</dependency>
				<!-- java-keyring logs through slf4j: with no backend, slf4j prints a three-line warning
				     in the shell the first time the keychain is used -->
				<dependency>
					<groupId>org.slf4j</groupId>
					<artifactId>slf4j-nop</artifactId>
					<version>1.7.36</version>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
		<!-- Bundles the JDBC file system too: mvn -Pjdbc ... (it isn't in the default build) -->
		<profile>
			<id>jdbc</id>
			<dependencies>
				<dependency>
					<groupId>us.bringardner.parley</groupId>
					<artifactId>parley-files-jdbc</artifactId>
					<version>${parley.version}</version>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
		<!--
		  Release profile: everything Maven Central needs.
		    mvn -Prelease clean deploy
		  Kept out of normal builds so day-to-day work needs no GPG key or Central token.
		-->
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<version>3.3.1</version>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals>
									<goal>jar-no-fork</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<version>3.11.2</version>
						<configuration>
							<!-- Lenient so existing code releases cleanly; tighten to all,-missing later -->
							<doclint>none</doclint>
							<release>${maven.compiler.release}</release>
						</configuration>
						<executions>
							<execution>
								<id>attach-javadocs</id>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.7</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
								<!-- Passphrase comes from the MAVEN_GPG_PASSPHRASE environment variable -->
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.11.0</version>
						<extensions>true</extensions>
						<configuration>
							<!-- Matches the <server><id> in ~/.m2/settings.xml -->
							<publishingServerId>central</publishingServerId>
							<!-- false: you review and click Publish on central.sonatype.com -->
							<autoPublish>false</autoPublish>
							<deploymentName>${project.artifactId} ${project.version}</deploymentName>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<!-- Eclipse has resources/ as a source folder; Maven has to be told (BJL-25).
		     The IDE (and its images) moved to fsh-ide (BJL-88). -->
		<resources>
			<resource>
				<directory>resources</directory>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<!-- the pom's version, for Console.VERSION (the version fsh reports) -->
			<resource>
				<directory>src/main/filtered</directory>
				<filtering>true</filtering>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.2</version>
				<configuration>
					<archive>
						<manifestEntries>
							<Automatic-Module-Name>us.bringardner.fsh</Automatic-Module-Name>
						</manifestEntries>
						<manifest>
							<mainClass>us.bringardner.fsh.Console</mainClass>
							<addClasspath>true</addClasspath>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<!-- target/fsh.jar: fsh and everything it needs in one runnable jar (java -jar target/fsh.jar).
			     Built by Maven so it always matches the pom, including the keychain profile; the
			     META-INF/services files of the libraries are merged, so every factory and credential
			     store is found. (An IDE's "export runnable jar" packs whatever its classpath held.) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.0</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<outputFile>${project.build.directory}/fsh.jar</outputFile>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>us.bringardner.fsh.Console</mainClass>
								</transformer>
							</transformers>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<exclude>META-INF/versions/*/module-info.class</exclude>
										<exclude>module-info.class</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- fsh-VERSION-PLATFORM.jar, attached: the keyboard library and fshexec of this platform
			     (compile.sh in linux/ or macos/), which parley-launcher unpacks for fsh. Made only where
			     they have been built (a native-PLATFORM profile); else there is nothing to put in it. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
				<executions>
					<execution>
						<id>native-files</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/native/${fsh.platform}</outputDirectory>
							<resources>
								<resource>
									<directory>${basedir}/${fsh.native.dir}</directory>
									<includes>
										<include>libnativekeyboard.so</include>
										<include>libnativekeyboard.dylib</include>
										<include>fshexec</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.2</version>
				<executions>
					<execution>
						<id>native-jar</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classesDirectory>${project.build.directory}/native/${fsh.platform}</classesDirectory>
							<classifier>${fsh.platform}</classifier>
							<skipIfEmpty>true</skipIfEmpty>
							<archive>
								<addMavenDescriptor>false</addMavenDescriptor>
								<manifest>
									<addClasspath>false</addClasspath>
									<mainClass combine.self="override"/>
								</manifest>
								<manifestEntries combine.self="override"/>
							</archive>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- META-INF/parley/launcher.list in the jar: what parley-launcher needs to run fsh (its
			     options, as linux/fsh and macos/fsh have them; the platform's native jar, unpacked into
			     {native}, for the keyboard library and fshexec) and every jar fsh needs, with its SHA-256 -->
			<plugin>
				<groupId>us.bringardner.parley</groupId>
				<artifactId>parley-launcher-maven-plugin</artifactId>
				<version>${parley.version}</version>
				<executions>
					<execution>
						<goals>
							<goal>list</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<mainClass>us.bringardner.fsh.Console</mainClass>
					<options>
						<!-- (deep recursion in scripts, as bash allows it; the serial collector with a
						     small young generation, its heap given back when it is not used; the
						     open-files limit as the caller left it; never a window) -->
						<option>-Xss16m</option>
						<option>-XX:+UseSerialGC</option>
						<option>-Xmn16m</option>
						<option>-XX:MinHeapFreeRatio=10</option>
						<option>-XX:MaxHeapFreeRatio=20</option>
						<option>-XX:-MaxFDLimit</option>
						<option>-Djava.awt.headless=true</option>
						<option>-Djava.library.path={native}</option>
						<!-- (Java 24 and later warn about JNI without it; Java 11 doesn't start with it) -->
						<option>17+:--enable-native-access=ALL-UNNAMED</option>
					</options>
					<nativeClassifier>{platform}</nativeClassifier>
					<!-- (without the native jar fsh uses JNA: see Native support in README.md) -->
					<nativeOptional>true</nativeOptional>
					<!-- (through fshexec -j: the signals the shell was started ignoring, which the JVM may take over) -->
					<wrapper>
						<part>{native}/fshexec</part>
						<part>-j</part>
					</wrapper>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.13.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.5.2</version>
					<configuration>
						<systemPropertyVariables>
							<!-- JNA unpacks its library into the user's cache folder, and the tests
							     point the home folder at the test files: keep it under target -->
							<jna.tmpdir>${project.build.directory}/jna</jna.tmpdir>
							<!-- TestBashCompat writes its results (one line per case) here; everything else
							     the tests write goes into JUnit @TempDir folders -->
							<parley.fsh.test.reportDir>${project.build.directory}</parley.fsh.test.reportDir>
						</systemPropertyVariables>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<!-- GitHub Packages -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>tony-bringardner</name>
			<url>https://maven.pkg.github.com/tony-bringardner/fsh</url>
		</repository>
	</distributionManagement>

	<dependencies>
		<!-- Plugins (and what parley-files is built on) -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-core</artifactId>
			<version>${parley.version}</version>
		</dependency>
		<!-- The FileSource API -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>${parley.version}</version>
		</dependency>
		<!-- The keyboard and terminal (raw mode, keys, size, lending the terminal) and the line editor -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-term</artifactId>
			<version>${parley.version}</version>
		</dependency>
		<!-- The terminal file browser and its commands (browse, view, edit, search), built in: Parley's
		     own terminal code, no UI library -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-viewer-tui</artifactId>
			<version>${parley.version}</version>
			<exclusions>
				<!-- (as before: the JDBC file system only with -Pjdbc) -->
				<exclusion>
					<groupId>us.bringardner.parley</groupId>
					<artifactId>parley-files-jdbc</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- The look of fsh's own window (ConsoleFrame), shared with the other Parley applications -->
		<dependency>
			<groupId>us.bringardner</groupId>
			<artifactId>bringardner-swing-widgets</artifactId>
			<version>1.1.0-SNAPSHOT</version>
		</dependency>
		<!-- Not used by fsh's code: bundled so fsh can work on FTP and SFTP file systems
		     out of the box. FileSourceFactory finds them at run time through ServiceLoader. -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-ftp</artifactId>
			<version>${parley.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-sftp</artifactId>
			<version>${parley.version}</version>
			<scope>runtime</scope>
		</dependency>
		<!-- parley-files-sftp has no SSH library of its own: the provider for Parley's own one, which it
		     prefers when it's there (JSch or MINA could be added instead) -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-sftp-parley-ssh</artifactId>
			<version>${parley.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Only for us.bringardner.fsh.ssh (fsh as the shell of a parley-ssh server). Optional: a
		     program that runs an SshServer has parley-ssh already, and fsh itself doesn't need it. -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-ssh</artifactId>
			<version>${parley.version}</version>
			<optional>true</optional>
		</dependency>

		<!-- Optional at run time: the keyboard and terminal (parley-term) and starting programs
		     (NativeKeyboard) through libc and kernel32 where the JNI library (macos/, linux/, windows/)
		     is not built. Without it fsh works as before; with the library, JNA is not loaded
		     (-Dparley.fsh.native=jna to use it). -->
		<dependency>
			<groupId>net.java.dev.jna</groupId>
			<artifactId>jna</artifactId>
			<version>5.19.1</version>
		</dependency>

		<!-- The tests use JUnit 5 (plus JUnit 4's Assert in places) -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.11.4</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.12</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
