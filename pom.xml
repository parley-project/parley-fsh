<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- fsh, the FileSource Shell. Built on Parley (parley-files) but not part of it. -->
	<groupId>us.bringardner</groupId>
	<artifactId>fsh</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>fsh - the FileSource Shell</name>
	<description>A bash-like shell whose file system is any parley-files FileSource: the local disk,
		memory, FTP, SFTP or a database. Formerly us.bringardner:bjl_shell (BjlShell).</description>
	<url>https://github.com/tony-bringardner/fsh</url>
	<inceptionYear>2004</inceptionYear>

	<licenses>
		<license>
			<name>The Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<developers>
		<developer>
			<id>tony-bringardner</id>
			<name>Tony Bringardner</name>
			<url>https://github.com/tony-bringardner</url>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:https://github.com/tony-bringardner/fsh.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/tony-bringardner/fsh.git</developerConnection>
		<url>https://github.com/tony-bringardner/fsh/tree/master</url>
	</scm>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>21</maven.compiler.release>
		<parley.version>1.0.0-SNAPSHOT</parley.version>
	</properties>

	<profiles>
		<!-- Native binary named fsh: mvn -Pnative package (add jdbc to include the JDBC file system) -->
		<profile>
			<id>native</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.graalvm.buildtools</groupId>
						<artifactId>native-maven-plugin</artifactId>
						<version>0.11.0</version>
						<extensions>true</extensions>
						<executions>
							<execution>
								<id>build-native</id>
								<goals>
									<goal>compile-no-fork</goal>
								</goals>
								<phase>package</phase>
							</execution>
						</executions>
						<configuration>
							<imageName>fsh</imageName>
							<mainClass>us.bringardner.fsh.Console</mainClass>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!-- Bundles the JDBC file system too: mvn -Pjdbc ... (it isn't in the default build) -->
		<profile>
			<id>jdbc</id>
			<dependencies>
				<dependency>
					<groupId>us.bringardner.parley</groupId>
					<artifactId>parley-files-jdbc</artifactId>
					<version>${parley.version}</version>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
	</profiles>

	<build>
		<!-- Eclipse has resources/ and generated/ (the generated ANTLR parser) as source
		     folders; Maven has to be told, or it can't build the project (BJL-25).
		     The IDE (and its images) moved to fsh-ide (BJL-88). -->
		<resources>
			<resource>
				<directory>resources</directory>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.0</version>
				<executions>
					<execution>
						<id>add-generated-parser</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>generated</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.2</version>
				<configuration>
					<archive>
						<manifest>
							<mainClass>us.bringardner.fsh.Console</mainClass>
							<addClasspath>true</addClasspath>
						</manifest>
					</archive>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.13.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.5.2</version>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<!-- GitHub Packages -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>tony-bringardner</name>
			<url>https://maven.pkg.github.com/tony-bringardner/fsh</url>
		</repository>
	</distributionManagement>

	<dependencies>
		<!-- The FileSource API: the only Parley module fsh's code uses -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>${parley.version}</version>
		</dependency>
		<!-- Not used by fsh's code: bundled so fsh can work on FTP and SFTP file systems
		     out of the box. FileSourceFactory finds them at run time through ServiceLoader. -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-ftp</artifactId>
			<version>${parley.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-sftp</artifactId>
			<version>${parley.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- The parser in generated/ needs only the ANTLR runtime -->
		<dependency>
			<groupId>org.antlr</groupId>
			<artifactId>antlr4-runtime</artifactId>
			<version>4.13.2</version>
		</dependency>
		<!-- The full tool, for the test utilities that regenerate the parser (AntlrBuild*) -->
		<dependency>
			<groupId>org.antlr</groupId>
			<artifactId>antlr4</artifactId>
			<version>4.13.2</version>
			<scope>test</scope>
		</dependency>

		<!-- The tests use JUnit 5 (plus JUnit 4's Assert in places) -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.11.4</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.12</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
